{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo-reporting-system.local/contracts/social_studio/v1.schema.json",
  "title": "Social Studio Workspace v1",
  "description": "SSOT data contract for the Social Studio agency app (web UI + iOS app). One workspace = one agency with its clients, content pipeline, scripts, shot lists, shoots and media reviews. Field names are camelCase and shared 1:1 by the TypeScript (web) and Swift (iOS) models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspace",
    "team",
    "clients",
    "contents",
    "scripts",
    "shots",
    "shoots",
    "media",
    "activity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "currentUserId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "currentUserId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/teamMember"
      },
      "minItems": 1
    },
    "clients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/client"
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/content"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "shoots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shoot"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaAsset"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "platform": {
      "enum": [
        "instagram",
        "tiktok",
        "youtube",
        "linkedin",
        "facebook",
        "pinterest"
      ]
    },
    "format": {
      "enum": [
        "reel",
        "tiktok",
        "short",
        "story",
        "carousel",
        "post",
        "longform"
      ]
    },
    "aspectRatio": {
      "enum": [
        "9:16",
        "4:5",
        "1:1",
        "16:9"
      ]
    },
    "stage": {
      "description": "Content pipeline stage, in order.",
      "enum": [
        "idea",
        "script",
        "script_review",
        "shoot",
        "edit",
        "cut_review",
        "scheduled",
        "published"
      ]
    },
    "teamMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "lead",
            "strategist",
            "creator",
            "videographer",
            "editor",
            "client"
          ]
        },
        "email": {
          "type": "string"
        },
        "clientId": {
          "description": "Only for role=client: the client this person belongs to.",
          "$ref": "#/$defs/id"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "color",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "active": {
          "type": "boolean"
        },
        "handles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instagram": {
              "type": "string"
            },
            "tiktok": {
              "type": "string"
            },
            "youtube": {
              "type": "string"
            },
            "linkedin": {
              "type": "string"
            },
            "facebook": {
              "type": "string"
            },
            "pinterest": {
              "type": "string"
            }
          }
        },
        "contactName": {
          "type": "string"
        },
        "contactEmail": {
          "type": "string"
        },
        "brandNotes": {
          "type": "string",
          "description": "Tonalität, Do's & Don'ts, CI-Hinweise."
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Content-Säulen des Kunden."
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clientId",
        "title",
        "format",
        "platforms",
        "stage",
        "assigneeIds",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "clientId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/platform"
          }
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "pillar": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "assigneeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "dueDate": {
          "$ref": "#/$defs/date"
        },
        "publishAt": {
          "$ref": "#/$defs/dateTime"
        },
        "shootId": {
          "$ref": "#/$defs/id"
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "voiceover": {
          "type": "string"
        },
        "onScreenText": {
          "type": "string"
        },
        "visual": {
          "type": "string",
          "description": "Was ist im Bild zu sehen?"
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentId",
        "version",
        "status",
        "hook",
        "scenes",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contentId": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "changes_requested",
            "approved"
          ]
        },
        "hook": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "caption": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#\\S+$"
          }
        },
        "cta": {
          "type": "string"
        },
        "reviewNote": {
          "type": "string",
          "description": "Letzte Rückmeldung aus der Freigabe."
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentId",
        "order",
        "description",
        "framing",
        "angle",
        "movement",
        "aspectRatio",
        "done"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contentId": {
          "$ref": "#/$defs/id"
        },
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "framing": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "medium_close",
            "close_up",
            "extreme_close_up",
            "detail"
          ]
        },
        "angle": {
          "enum": [
            "eye_level",
            "high",
            "low",
            "birds_eye",
            "worms_eye",
            "dutch",
            "pov",
            "over_shoulder"
          ]
        },
        "movement": {
          "enum": [
            "static",
            "pan",
            "tilt",
            "dolly",
            "gimbal_follow",
            "handheld",
            "zoom",
            "orbit",
            "slider"
          ]
        },
        "aspectRatio": {
          "$ref": "#/$defs/aspectRatio"
        },
        "lens": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "callSheetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "label"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clientId",
        "title",
        "date",
        "startTime",
        "endTime",
        "status",
        "location",
        "teamIds",
        "contentIds",
        "equipment",
        "schedule"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "clientId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "startTime": {
          "$ref": "#/$defs/time"
        },
        "endTime": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "enum": [
            "planned",
            "confirmed",
            "done",
            "cancelled"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "teamIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callSheetEntry"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reviewComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorId",
        "text",
        "createdAt",
        "resolved"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "authorId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "timestampSec": {
          "type": "number",
          "minimum": 0,
          "description": "Position im Video, auf die sich der Kommentar bezieht."
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "resolved": {
          "type": "boolean"
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentId",
        "kind",
        "fileName",
        "version",
        "status",
        "uploadedById",
        "uploadedAt",
        "comments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contentId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "raw",
            "cut",
            "final",
            "thumbnail"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "description": "raw: uploaded -> ready_for_edit (zum Schnitt freigegeben) -> in_edit. cut/final: in_review -> changes_requested | approved.",
          "enum": [
            "uploaded",
            "ready_for_edit",
            "in_edit",
            "in_review",
            "changes_requested",
            "approved"
          ]
        },
        "storageKey": {
          "type": "string",
          "description": "Opaque key of the binary in the storage backend. Absent for metadata-only records (e.g. seed data)."
        },
        "uploadedById": {
          "$ref": "#/$defs/id"
        },
        "uploadedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewComment"
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actorId",
        "kind",
        "targetType",
        "targetId",
        "message",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "created",
            "updated",
            "stage_changed",
            "submitted",
            "approved",
            "changes_requested",
            "uploaded",
            "released_for_edit",
            "commented"
          ]
        },
        "targetType": {
          "enum": [
            "content",
            "script",
            "shoot",
            "media",
            "client"
          ]
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "type": "string",
          "description": "Human-readable fallback text in the author's UI language. Clients render `params` in the viewer's language when present."
        },
        "at": {
          "$ref": "#/$defs/dateTime"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event"
          ],
          "description": "Structured, language-neutral event data used to render the activity in the viewer's UI language (i18n key: activity.<event>).",
          "properties": {
            "event": {
              "enum": [
                "content_created",
                "content_stage_changed",
                "content_deleted",
                "script_created",
                "script_version_created",
                "script_submitted",
                "script_approved",
                "script_changes_requested",
                "shoot_created",
                "shoot_updated",
                "shoot_deleted",
                "media_uploaded_raw",
                "media_uploaded_cut",
                "media_uploaded_thumbnail",
                "media_released",
                "media_edit_started",
                "media_approved",
                "media_changes_requested",
                "media_commented",
                "media_deleted",
                "client_created",
                "client_updated"
              ]
            },
            "title": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "stage": {
              "$ref": "#/$defs/stage"
            },
            "fileName": {
              "type": "string"
            },
            "date": {
              "$ref": "#/$defs/date"
            }
          }
        }
      }
    }
  }
}
