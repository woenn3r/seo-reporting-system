{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@contracts/*": [
        "../../../contracts/*"
      ],
      "@examples/*": [
        "../../../examples/*"
      ],
      "@i18n/*": [
        "../i18n/*"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}